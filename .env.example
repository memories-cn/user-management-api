# 运行环境：dev | production
APP_ENV=dev
# HTTP 监听地址
APP_HTTP_ADDR=:8080
# 优雅关闭宽限期
APP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL 连接串（必填）
DATABASE_DSN=postgres://postgres:postgres@localhost:5432/iam?sslmode=disable

# Redis 地址（可选，当前仅解析不使用）
REDIS_ADDR=

# ZITADEL Issuer（必填；生产环境必须是 https，尾斜杠会被自动去掉）
ZITADEL_ISSUER=https://auth.example.com
# 预期受众（必填，必须与令牌中的 aud 匹配，不能猜测）
ZITADEL_API_AUDIENCE=iam-api-audience
# 客户端 ID（可选，仅记录）
ZITADEL_CLIENT_ID=
# 访问 ZITADEL 管理 API 的服务身份凭据（可选，当前阶段不使用）
ZITADEL_SERVICE_CREDENTIALS_FILE=

# 令牌校验模式：当前仅支持 jwt（本地验签）
AUTH_TOKEN_MODE=jwt
# JWKS 缓存 TTL：当前仅解析不生效，密钥缓存与轮换由 go-oidc 内部策略决定
AUTH_JWKS_CACHE_TTL=15m

# 平台管理员对应的 ZITADEL 角色名（必填，置空则启动失败）
# 平台管理员只能通过该角色授予，服务端不提供白名单或应急通道。
PLATFORM_ADMIN_ROLE_KEY=platform_admin
# 成员邀请有效期（默认 7 天）
INVITATION_TTL=168h

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# Casbin 模型文件路径
CASBIN_MODEL_PATH=./casbin/model.conf

# 成员加入租户时绑定的默认角色（必须是 owner/admin/member/viewer 之一）
DEFAULT_MEMBER_ROLE_KEY=member

# 跨实例策略失效检查间隔：角色权限变更在其他实例上的可见延迟不超过该值。
# 成员移除与停用不依赖该窗口（租户守卫每次请求直查数据库）。
POLICY_REFRESH_INTERVAL=5s

# ---- 运行期加固（Milestone 6） ----

# 可信代理的 CIDR/IP 列表（逗号分隔）。空值 = 不信任任何代理。
# 部署在反向代理之后时必须配置，否则未认证请求会共享同一个 IP 限流桶
# （全部用户被连带限流），且审计 ip_address 不可信。
# 示例（traefik 所在 Docker 网络）：TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# 限流：管理类接口与授权判定接口分开配置。
# 授权判定在业务热路径上，阈值必须显著更宽，否则要么误限业务调用，
# 要么让管理接口形同不限。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MANAGE_RPS=10
RATE_LIMIT_AUTHORIZE_RPS=100
# 令牌桶容量倍率：burst = rps × 该值，允许短时突发而不放开持续速率。
RATE_LIMIT_BURST=2

# 指标端点。/metrics 必须由边缘网关阻断，不对公网暴露。
METRICS_ENABLED=true
METRICS_PATH=/metrics
